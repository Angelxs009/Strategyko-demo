# Modo de tarifas: demo (simulado) o live (requiere credenciales)
RATES_MODE=demo
PORT=4000
CORS_ORIGINS=http://localhost:3000
# Si se define, todas las rutas /api exigen el header x-api-key
SERVICE_API_KEY=
DATABASE_URL=postgresql://strategyko:strategyko@localhost:55434/strategyko_rates
DEV_TENANT_ID=dev-tenant
# Envio a Strategyko (vacio = dry-run)
STRATEGYKO_URL=
STRATEGYKO_API_KEY=
# --- Modo live (RATES_MODE=live) ---
# Cada naviera necesita: BASE_URL y (TOKEN_URL + CLIENT_ID + CLIENT_SECRET) o API_KEY.
# Los valores salen de la cuenta de cada portal; NO inventes URLs. Ver TODO(angel) en src/carriers/live/.
MAERSK_BASE_URL=
MAERSK_TOKEN_URL=
MAERSK_CLIENT_ID=
MAERSK_CLIENT_SECRET=
MAERSK_API_KEY=
CMACGM_BASE_URL=
CMACGM_TOKEN_URL=
CMACGM_CLIENT_ID=
CMACGM_CLIENT_SECRET=
CMACGM_API_KEY=
HAPAG_BASE_URL=
HAPAG_TOKEN_URL=
HAPAG_CLIENT_ID=
HAPAG_CLIENT_SECRET=
